form Appointments
{
    displayname = "Appointments"

    Appointment_Details
    (
        type = section
        displayname = "Appointment Details"
        row = 1
        column = 0
    )

    must have Title
    (
        type = text
        displayname = "Title"
        maxchar = 255
        row = 1
        column = 1
        width = medium
    )

    Client_Name
    (
        type = name
        displayname = "Client Name"
        prefix
        (
            type = prefix
            displayname = "Title"
            value = {"Mr.", "Mrs.", "Ms.", "Dr."}
            visibility = false
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 1
        column = 1
        width = medium
    )

    Email
    (
        type = email
        displayname = "Email"
        row = 1
        column = 1
        width = medium
    )

    Phone
    (
        type = phonenumber
        displayname = "Phone"
        row = 1
        column = 1
        width = medium
    )

    must have Appointment_Date
    (
        type = date
        displayname = "Appointment Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )

    must have Start_Time
    (
        type = time
        displayname = "Start Time"
        row = 1
        column = 1
        width = medium
    )

    End_Time
    (
        type = time
        displayname = "End Time"
        row = 1
        column = 1
        width = medium
    )

    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Scheduled","Confirmed","Completed","Cancelled","No Show"}
        initial value = "Scheduled"
        row = 1
        column = 1
        width = medium
    )

    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 80px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
